# ============================================================================
# M4STCLAW v3.6.0 — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your API keys.
# Keys are loaded automatically on startup.
#
# Multiple keys per provider are supported for rotation:
#   GROQ_API_KEY=your_primary_key
#   GROQ_API_KEY_1=your_second_key
#   GROQ_API_KEY_2=your_third_key
#
# Smart key detection is also supported:
#   SMART_KEY_1=gsk_xxx    (auto-detected as Groq)
#   SMART_KEY_2=AIzaXxx    (auto-detected as Gemini)
# ============================================================================

# ── LLM Provider Keys ──────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
TOGETHER_API_KEY=

# ── Integration Keys ───────────────────────────────────────────────────
COMPOSIO_API_KEY=
SHODAN_API_KEY=

# ── Smart Key Rotation (Auto-Detected by Prefix) ──────────────────────
# SMART_KEY_1=
# SMART_KEY_2=
# SMART_KEY_3=

# ── Security Scoping ──────────────────────────────────────────────────
# Comma-separated list of allowed pentest scan targets
# M4STCLAW_ALLOWED_SCOPE=localhost,127.0.0.1

# ── Custom Config Directory (Optional) ────────────────────────────────
# M4STCLAW_CONFIG=/path/to/custom/config
